rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User Projects
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }

      // User Files
      match /files/{fileId} {
        allow read, write: if isOwner(userId);
      }

      // User Notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // User Activity Logs
      match /activityLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Publicly Token-Addressed Shared Links
    match /shareLinks/{token} {
      // Anyone with the cryptographic token can read the shared deliverable metadata
      allow get: if true;

      // Only signed in user can create a link with their own ownerId
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;

      // Owner can update everything; clients can only increment viewsCount or downloadsCount
      allow update: if (isSignedIn() && existing().ownerId == request.auth.uid) ||
                       (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'downloadsCount']));

      // Only owner can delete
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
